DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=fixsure_mvp
PORT=3000

# ============================================
# Paga Engine API Configuration (https://developer-docs.paga.com/)
# ============================================
PAGA_ENVIRONMENT=sandbox
# Paga Collect API Credentials
PAGA_PUBLIC_KEY=your_paga_public_key
PAGA_SECRET_KEY=your_paga_secret_key
PAGA_HASH_KEY=your_paga_hash_key

# Paga Business API Credentials (for Payout / Money Transfer)
PAGA_PRINCIPAL=your_paga_principal
PAGA_CREDENTIALS=your_paga_credentials

# Webhook Callback URL
PAGA_CALLBACK_URL=http://localhost:3000/api/webhooks/paga
